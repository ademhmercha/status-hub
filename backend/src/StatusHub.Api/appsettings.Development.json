{
  "StatusHub": {
    "LocalWorker": true
  },
  "DynamoDb": {
    "ServiceUrl": "http://localhost:8000",
    "TableName": "statushub-local"
  },
  "Checker": {
    "AllowPrivateTargets": true
  },
  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "localhost",
    "SmtpPort": "1025",
    "From": "alerts@statushub.local"
  },
  "Auth": {
    "DevTokens": true,
    "DevSigningKey": "local-development-signing-key-change-me-0123456789"
  },
  "Demo": {
    "Enabled": true
  },
  "Cors": {
    "Origins": "http://localhost:4200"
  },
  "Urls": "http://localhost:5080",
  "RateLimit": {
    "ApiPerMinute": 100000,
    "DemoPerMinute": 1000,
    "PublicPerMinute": 100000,
    "TokenPerMinute": 100000
  }
}
